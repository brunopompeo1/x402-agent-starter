# Wallet on Base Mainnet (Private Key for automated x402 signing)
WALLET_PRIVATE_KEY=0x_your_private_key_here
RPC_URL=https://base-rpc.publicnode.com

# Or Coinbase Developer Platform (CDP) API credentials for AgentKit MPC Wallet
CDP_API_KEY_NAME=your_cdp_key_name
CDP_API_KEY_PRIVATE_KEY="-----BEGIN EC PRIVATE KEY-----\n...\n-----END EC PRIVATE KEY-----"

# OpenAI or Anthropic API Key for the LLM Agent Brain
OPENAI_API_KEY=sk-proj-...

# Optional: Proxy Gateway URL (if paying via Credit Card / PIX instead of crypto)
X402_PROXY_URL=https://x402-card-proxy.architect-x402.workers.dev
